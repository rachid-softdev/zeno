# Supabase (Frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Anthropic Claude (direct browser calls in mock mode)
VITE_ANTHROPIC_API_KEY=sk-ant-your-key

# Backend API (when using Fastify backend)
VITE_API_URL=http://localhost:3001/api

# When VITE_API_URL is not configured, the app runs in mock mode with demo data
